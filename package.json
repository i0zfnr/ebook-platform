{
  "name": "ebook-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FlipBook Interactive E-Book Platform Monorepo by Hafizul Irfan",
  "scripts": {
    "dev:backend": "cd backend && php artisan serve --port=8001",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
